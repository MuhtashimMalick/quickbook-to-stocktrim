# Copy to .env (never commit it). Read by docker-compose.yml (the only place credentials live).
# Generate every secret with: openssl rand -hex 24

# --- Database ---
# DB passwords must be URL-safe ([A-Za-z0-9_-]): they are embedded in DATABASE_URL.
# POSTGRES_USER is the DB owner (runs migrations, used by tests). The app itself connects as the least-privilege role qb_app.
POSTGRES_USER=qb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qb_stocktrim
APP_DB_PASSWORD=change-me-too

# --- Public address (Caddy gets a Let's Encrypt cert for DOMAIN; needs a public DNS A record + inbound 80/443) ---
DOMAIN=quickbooks.example.com
# https://<DOMAIN>/qbwc. When DOMAIN changes, update both and re-issue the .qwc.
APP_URL=https://quickbooks.example.com/qbwc
# Optional: contact email for Let's Encrypt expiry notices (leave empty to skip).
ACME_EMAIL=

# --- QuickBooks Web Connector ---
QBWC_USERNAME=specialty-archery
# Send the password to the client separately from the .qwc.
QBWC_PASSWORD=change-me-long-random
# Protects the admin API (X-Admin-Token header).
ADMIN_TOKEN=change-me-admin
# Stable Specialty Archery GUIDs (not secrets). Never change once the .qwc is imported.
QWC_OWNER_ID=977e21e5-98f1-440d-ac64-461878a8262c
QWC_FILE_ID=21dfbdc4-f9b7-44bc-aed1-605d1aa21cc0
QWC_APP_NAME=Specialty Archery StockTrim
QWC_APP_DESCRIPTION=Specialty Archery: QuickBooks Desktop <-> StockTrim sync
QWC_FILENAME=SpecialtyArchery-StockTrim.qwc

# --- Behaviour ---
RUN_EVERY_N_SECONDS=600
# create_test_po is refused unless true. Enable only deliberately.
WRITES_ENABLED=false
MAX_QBXML_VERSION=16.0
PAGE_SIZE=100
SAVE_FIXTURES=false
LOG_RETENTION_DAYS=14

# --- StockTrim (optional until the sync runs; the app starts without them) ---
# Use the TEST account while developing. Never commit real values.
STOCKTRIM_BASE_URL=https://api.stocktrim.com
STOCKTRIM_AUTH_ID=
STOCKTRIM_AUTH_SIGNATURE=
# Client-side limits (requests per second, parallel calls)
STOCKTRIM_MAX_RPS=5
STOCKTRIM_CONCURRENCY=4
# Wall-clock cap in seconds for one call including retries (10-600)
STOCKTRIM_MAX_CALL_SECONDS=90
# test | production. Scopes the BOM ledger and push runs to one StockTrim account; production deployments MUST set production.
STOCKTRIM_ENVIRONMENT=test
STOCKTRIM_WRITES_ENABLED=false
# Product SKU source: QuickBooks item Name (decided) or FullName
PRODUCT_KEY_FIELD=Name
# Negative QuickBooks stock: as_is (send the negative number, default) or clamp (send 0)
NEGATIVE_STOCK_POLICY=as_is
