# Copy to .env. Never commit .env.
# Credentials QuickBooks Web Connector will use. Generate secrets with:
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
QBWC_USERNAME=specialty-archery
# Send the password to the client separately from the .qwc.
QBWC_PASSWORD=change-me-long-random
# Protects the admin API (X-Admin-Token header).
ADMIN_TOKEN=change-me-admin
# Stable Specialty Archery GUIDs (not secrets). Never change once the .qwc is imported.
QWC_OWNER_ID=977e21e5-98f1-440d-ac64-461878a8262c
QWC_FILE_ID=21dfbdc4-f9b7-44bc-aed1-605d1aa21cc0
QWC_APP_NAME=Specialty Archery StockTrim
QWC_APP_DESCRIPTION=Specialty Archery: QuickBooks Desktop <-> StockTrim sync
QWC_FILENAME=SpecialtyArchery-StockTrim.qwc
# Public https URL of /qbwc. When moving to the hosted server change only this and re-issue the .qwc; OwnerID/FileID stay.
APP_URL=https://unrupturable-unreticently-carl.ngrok-free.dev/qbwc
# QWC_SUPPORT_URL=https://unrupturable-unreticently-carl.ngrok-free.dev/qbwc
RUN_EVERY_N_SECONDS=600
# SQLite by default; Postgres later, e.g. postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./qb_poc.db
# create_test_po is refused unless this is true. Enable only deliberately, for a specific write test.
WRITES_ENABLED=false
# Highest qbXML version we will speak; min(QuickBooks version, this) is used per request.
MAX_QBXML_VERSION=16.0
PAGE_SIZE=100
FIXTURES_DIR=fixtures/qbxml
SAVE_FIXTURES=true
# Daily-rotating JSONL log of QBWC callbacks (no passwords, full tickets or qbXML bodies).
LOG_DIR=logs
LOG_RETENTION_DAYS=14
