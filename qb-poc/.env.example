# Copy to .env. Never commit .env.
# Credentials QuickBooks Web Connector will use (set the same password in the Web Connector).
QBWC_USERNAME=qbwc_poc
QBWC_PASSWORD=change-me-qbwc
# Protects the admin API (send as X-Admin-Token header).
ADMIN_TOKEN=change-me-admin
# Keep these GUIDs STABLE once the .qwc is imported; changing them forces re-authorization in QuickBooks.
# Generate your own: python -c "import uuid;print(uuid.uuid4())"
QWC_OWNER_ID=2257aede-acc8-4228-b7c0-f51409a87a8f
QWC_FILE_ID=29f7be25-93f8-48e4-a24e-e7fc40261e60
QWC_APP_NAME=QuickBooks StockTrim POC
QWC_APP_DESCRIPTION=Proof of concept: read/write QuickBooks Desktop through qbwc-kit
APP_URL=http://localhost:8000/qbwc
# QWC_SUPPORT_URL=http://localhost:8000/qbwc
RUN_EVERY_N_SECONDS=600
# SQLite by default; Postgres later, e.g. postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./qb_poc.db
# create_test_po is refused unless this is true.
WRITES_ENABLED=false
# Highest qbXML version we will speak; min(QuickBooks version, this) is used per request.
MAX_QBXML_VERSION=16.0
PAGE_SIZE=100
FIXTURES_DIR=fixtures/qbxml
SAVE_FIXTURES=true
